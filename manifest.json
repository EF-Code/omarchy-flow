{
  "schemaVersion": 1,
  "id": "io.github.ef-code.omarchy-flow",
  "name": "Omarchy Flow",
  "version": "0.3.0",
  "author": "EF-Code",
  "license": "MIT",
  "description": "Voice dictation HUD pill and AI speech-to-text integration for Omarchy.",
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "overlay": "Pill.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Flow",
    "description": "Voice dictation HUD, settings hub, speech model switcher, and recording controller.",
    "category": "Input & AI",
    "aliases": [
      "dictate",
      "voice",
      "speech",
      "whisper",
      "gemini",
      "flow"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
